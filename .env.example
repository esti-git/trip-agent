# Copy this file to .env and fill in your key (.env is git-ignored).

# Required. OpenAI API key: https://platform.openai.com/api-keys
# (API credit is separate from a ChatGPT subscription.)
LLM_API_KEY=your_key_here

# Optional. Defaults to OpenAI with gpt-4o-mini:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODELS=

# Free alternative: Gemini (key at https://aistudio.google.com/apikey).
# Its free daily quota is small, so the fallback models help:
#   LLM_API_KEY=your_gemini_key
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash
#   LLM_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
