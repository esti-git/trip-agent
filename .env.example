# Copy this file to .env and fill in your key (.env is git-ignored).

# Required. Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=your_key_here

# Optional. Defaults to Gemini. To use OpenAI instead, set:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_FALLBACK_MODEL=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODEL=gemini-flash-lite-latest
